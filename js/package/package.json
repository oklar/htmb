{
  "name": "htmb",
  "version": "1.2.1",
  "description": "HTMB is a lightweight library for building HTML structures using functions",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "browser": "htmb.umd.js",
  "unpkg": "htmb.umd.js",
  "jsdelivr": "htmb.umd.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "import": "./index.mjs"
    }
  },
  "files": [
    "index.mjs",
    "htmb.umd.js",
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "test": "node index.test.js",
    "test:types": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oklar/htmb.git"
  },
  "keywords": [
    "html",
    "builder",
    "template",
    "hypertext",
    "markup"
  ],
  "author": "Olav Kjartan Larseng",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/oklar/htmb/issues"
  },
  "homepage": "https://github.com/oklar/htmb#readme"
}
